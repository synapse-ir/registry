# ============================================================
# SYNAPSE Registry — environment variables
# Copy to .env and fill in values before running.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
# SQLite (default for local dev — file created automatically)
DATABASE_URL=sqlite+aiosqlite:///./synapse.db
# PostgreSQL example (uncomment and install asyncpg extra):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/synapse

# ------------------------------------------------------------
# Environment
# Controls token expiry defaults and logging verbosity.
# Values: development | test | production
# ------------------------------------------------------------
SYNAPSE_ENV=development

# ------------------------------------------------------------
# Route cache (C1 — in-process LRU)
# ------------------------------------------------------------
# How long a cached route result stays valid (seconds)
SYNAPSE_ROUTE_CACHE_TTL_SECONDS=30
# Maximum number of route results to keep in cache
SYNAPSE_ROUTE_CACHE_MAX_ENTRIES=1000
# Redis URL for distributed route cache (leave blank to use in-process only)
SYNAPSE_ROUTE_CACHE_REDIS_URL=

# ------------------------------------------------------------
# Heartbeat cache (C3 — §8 C3)
# ------------------------------------------------------------
# How often the background thread polls each model's heartbeat endpoint
SYNAPSE_HEARTBEAT_POLL_INTERVAL_SECONDS=30
# Age (seconds) after which a cache entry is considered stale
# Stale entries are still routed to but logged as degraded
SYNAPSE_HEARTBEAT_STALE_THRESHOLD_SECONDS=30
# Age (seconds) after which a model is removed from routing candidates
SYNAPSE_HEARTBEAT_DROP_THRESHOLD_SECONDS=90
# Per-request timeout for each heartbeat HTTP poll (seconds)
SYNAPSE_HEARTBEAT_TIMEOUT_SECONDS=5

# ------------------------------------------------------------
# Calibration buffer (C5 — §8 C5)
# ------------------------------------------------------------
# Maximum signals buffered in memory before older ones are dropped
SYNAPSE_CAL_BUFFER_MAX=100
# How often the buffer is flushed to the Calibration Layer (seconds)
SYNAPSE_CAL_FLUSH_INTERVAL_SECONDS=5
# Maximum flush retry attempts on transient failure
SYNAPSE_CAL_MAX_RETRIES=3
# Set to false to disable calibration signal ingestion entirely
SYNAPSE_CAL_ENABLED=true

# ------------------------------------------------------------
# Context store (session context across IR hops)
# ------------------------------------------------------------
# Backend: memory | redis
SYNAPSE_CONTEXT_STORE_BACKEND=memory
# Time-to-live for session context entries (seconds)
SYNAPSE_CONTEXT_STORE_SESSION_TTL_SECONDS=3600

# ------------------------------------------------------------
# Observability (OpenTelemetry)
# ------------------------------------------------------------
# Set to true to export traces/metrics via OTLP
SYNAPSE_OTEL_ENABLED=false
